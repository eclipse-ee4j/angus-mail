# Diagnostic child JVMs only. Request frequent TLS 1.3 key updates without
# replacing the rest of the JDK security configuration.
jdk.tls.keyLimits=AES/GCM/NoPadding KeyUpdate 16384, ChaCha20-Poly1305 KeyUpdate 16384
